# claim-api configuration. Copy to .env and fill in. Never commit a real .env.

# Port the service listens on.
PORT=8080

# GitHub OAuth app credentials for the /auth/github flow (DEPLOY.md).
# Leave empty to run reads only; the write endpoints then accept only raw
# GitHub user tokens (PATs), which is enough for CLI device-flow usage.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of this instance, used to build the OAuth callback URL.
# Example: https://claim-api-<user>.replit.app
APP_BASE_URL=

# GitHub token used for authenticated READ calls (rate limits: 5000/hr).
# A fine-grained PAT with public-repo read, or the Actions-style app token.
# Without it, reads go out unauthenticated (60/hr) and will throttle.
SERVICE_GITHUB_TOKEN=

# Static Ledger base for GET /v1/repos/:owner/:repo/friction.
LEDGER_BASE_URL=https://cloudcorprecords.github.io/claim-ledger

# Secret used if a signed session format is adopted later. Currently the
# session tokens are opaque and this is unused; set it anyway so a future
# signed-token migration needs no config change.
SESSION_SECRET=
